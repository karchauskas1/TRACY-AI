# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=gpt-4o-mini

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/callback

# Database
# PostgreSQL (приоритет) - для синхронизации с веб-приложением
# Формат: postgresql://user:password@host:port/dbname
# Пример: postgresql://tracy_user:password@localhost:5432/tracy
DATABASE_URL=
# SQLite (fallback) - используется если DATABASE_URL не указан
DATABASE_PATH=./data/tracy.db

# Server
HOST=localhost
PORT=8080

# Default timezone
DEFAULT_TIMEZONE=Europe/Moscow

# Web Application
# HTTPS URL веб-приложения (GitHub Pages)
# Пример: https://your-username.github.io/tracy-ai-bot/
WEB_APP_URL=

# Feedback Service (Google Sheets/Drive)
# ID таблицы Google Sheets для обратной связи
FEEDBACK_SPREADSHEET_ID=
# Маппинг user_id -> название листа (формат: "user_id1:лист1,user_id2:лист2")
# Пример: "332023536:Тестировщик Катя,308477378:Тестировщик Даня"
FEEDBACK_SHEET_MAPPING=332023536:Тестировщик Катя,308477378:Тестировщик Даня
# URL Google Apps Script webhook для обратной связи (альтернативный способ записи)
# Если указан, бот будет использовать Apps Script вместо прямого API
FEEDBACK_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzuZ0Srf4nrFXdQsFbw-sfPD5lT3jhP8-lmBcZNweEQvg6qILXS2xMgv5xhAdi7F6gwnA/exec
